PORT=4000
MONGODB_URI=mongodb://localhost:27017/testing-delivery-os
NODE_ENV=development

# Optional: directory of the built frontend to serve beside the API (production)
# FRONTEND_DIST_DIR=./frontend-dist

# Optional: reverse proxies in front of the app whose X-Forwarded-For is trusted (default 1 in production, 0 otherwise)
# TRUST_PROXY_HOPS=1
# Optional: fatal, error, warn, info (default), debug, trace or silent
# LOG_LEVEL=info
